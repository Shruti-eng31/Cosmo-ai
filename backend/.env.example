# =============================================================================
# Cosmo AI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   PowerShell:  Copy-Item .env.example .env
#
# Lines starting with # are comments. Remove the # to activate a variable.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider  (REQUIRED — pick ONE of: gemini, openai, ollama)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Free tier: 15 requests/minute.
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI ---
# Paid API. Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=replace_with_your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local, free) ---
# Install Ollama: https://ollama.com/download
# Pull a model:   ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Embedding Model  (runs locally, no API key needed)
# ---------------------------------------------------------------------------
# HuggingFace model name for sentence-transformers.
# Default is small & fast (~80 MB). Alternatives:
#   all-MiniLM-L6-v2       (80 MB,  384-dim, fast)
#   all-mpnet-base-v2      (420 MB, 768-dim, better quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# RAG Settings
# ---------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# Paths (defaults are usually fine)
# ---------------------------------------------------------------------------
DOCUMENTS_DIR=data/documents
VECTOR_STORE_DIR=data/vector_store

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
MAX_QUESTION_LENGTH=1000
MAX_CONCURRENT_GENERATIONS=5
# ENABLE_ANSWER_CACHE=false
# ANSWER_CACHE_TTL_SECONDS=300
