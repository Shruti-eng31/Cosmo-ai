# ============================================================
# Cosmo AI Backend — .gitignore
# ============================================================

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Python virtual environment ---
venv/
.venv/
env/

# --- Python caches ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# --- Vector store (generated, not source code) ---
data/vector_store/

# --- HuggingFace / sentence-transformers model cache ---
.cache/

# --- IDE ---
.vscode/
.idea/

# --- OS ---
.DS_Store
Thumbs.db

# --- pytest ---
.pytest_cache/
htmlcov/
.coverage

# --- Logs ---
*.log
